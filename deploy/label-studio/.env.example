# Label Studio deployment — copy to .env and fill in. Never commit .env.
# Every variable here is required: the compose file refuses to start rather
# than silently booting with a blank password.

# --- Reachability -----------------------------------------------------------
# Interface to listen on. Use the server's LAN/VPN IP so only the office can
# reach it. 127.0.0.1 = SSH tunnel only:
#   ssh -L 8081:127.0.0.1:8081 user@server     then open http://localhost:8081
# NOTE: Docker publishes ports ahead of ufw, so ufw will NOT restrict this.
LS_BIND_IP=127.0.0.1
LS_PORT=8081

# --- First-run admin account ------------------------------------------------
# Created only when the database is empty. Existing installs keep their users.
LS_ADMIN_EMAIL=you@company.com
LS_ADMIN_PASSWORD=CHANGE_ME_long_random

# --- Photos -----------------------------------------------------------------
# Absolute host path to this repo's data/ directory — the one CONTAINING raw/,
# not raw/images itself. Mounted read-only at /label-studio/files, so in
# Label Studio's Local files storage the Absolute path is:
#   /label-studio/files/raw/images
SHELF_DATA_DIR=/srv/face-counter/data

# --- Postgres ---------------------------------------------------------------
POSTGRES_DB=labelstudio
POSTGRES_USER=labelstudio
POSTGRES_PASSWORD=CHANGE_ME_long_random
