# Copy to .env and fill in. Never commit .env.
# One .env per machine serves every entry point: the scripts, `uv run shelf-serve`
# (loaded by python-dotenv; real environment variables win), and the serving
# container (`docker run --env-file .env`). Docker passes EVERY line into the
# container, so on a server keep only what that host needs. Docker's
# --env-file does not strip quotes, so leave values unquoted.

# --- Data access (scripts) ---
# Use a READ-ONLY MongoDB user for exports (see README, "Read-only Mongo user").
MONGO_URI=mongodb://shelf_reader:CHANGE_ME@<db-server-ip>:27017/?authSource=admin
ANTHROPIC_API_KEY=<api-key>

# --- Serving API (`uv run shelf-serve` / deploy/serve.Dockerfile) ---
# Required anywhere but a laptop. Generate one with: openssl rand -hex 24
FACE_COUNTER_API_KEY=<random-key>
# CPU threads for ONNX Runtime; 0 = all cores. Use 2 on the shared apps server.
FACE_COUNTER_ORT_THREADS=0
# CLIP canned/glass stage: off by default (heavy on CPU, see ADR-0002).
FACE_COUNTER_CLASSIFY=0
# Listen address for `uv run shelf-serve`. The container image sets 0.0.0.0
# itself; public exposure is decided by `docker run -p`, not by this.
# FACE_COUNTER_HOST=127.0.0.1
# FACE_COUNTER_PORT=8000
