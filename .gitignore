# --- Python ---
__pycache__/
*.py[cod]
build/
dist/
wheels/
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# --- Secrets / env ---
.env
.env.*
!.env.example

# --- Company-confidential source documents (never commit) ---
# Sales/export invoices etc. used as input to build configs/classes.csv --
# contain pricing and customer/buyer data. The derived classes.csv (product
# names only) is fine to commit; the source spreadsheet never is.
configs/*.xlsm
configs/*.xlsx
configs/.~lock.*
# Packshots: real product photography, and the set is incomplete/evolving.
# Once complete, move to DVC like data/raw rather than committing to git.
configs/Product/

# --- DVC (belt-and-braces; dvc init already handles these) ---
/.dvc/cache
/.dvc/tmp
/.dvc/config.local

# --- Data & artifacts ---
# Exported photos: large, and DVC owns their versioning.
data/raw/
# Generated from the manifest by shelf-splits / shelf-label-prep; both are
# reproducible from data/raw + configs, so they are not worth tracking.
# Exception: test_labeling.txt is the FROZEN test set. It was hand-corrected
# on 2026-09-26 (two non-shelf photos swapped out), so no seed regenerates it,
# and every accuracy number is anchored to it. `data/splits/*` (not
# `data/splits/`) is what lets git re-include one file inside the directory.
data/splits/*
!data/splits/test_labeling.txt
data/label_studio/
trial.txt
# Don't blanket-ignore /data here. DVC writes precise
# per-folder .gitignore entries on `dvc add` / `dvc repro`.

# --- Model artifacts and training output ---
# Ultralytics writes runs/<task>/<name>/weights/*.pt; weights are versioned as
# model releases, never as git blobs.
runs/
*.pt
*.onnx

# --- ML noise not worth versioning at all ---
mlruns/
wandb/
*.log

# --- IDE / OS ---
.vscode/
.idea/
.DS_Store
