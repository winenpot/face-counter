# --- Python ---
__pycache__/
*.py[cod]
build/
dist/
wheels/
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# --- Secrets / env ---
.env
.env.*
!.env.example

# --- Company-confidential source documents (never commit) ---
# Sales/export invoices etc. used as input to build configs/classes.csv --
# contain pricing and customer/buyer data. The derived classes.csv (product
# names only) is fine to commit; the source spreadsheet never is.
configs/*.xlsm
configs/*.xlsx
configs/.~lock.*
# Packshots: real product photography, and the set is incomplete/evolving.
# Once complete, move to DVC like data/raw rather than committing to git.
configs/Product/

# --- DVC (belt-and-braces; dvc init already handles these) ---
/.dvc/cache
/.dvc/tmp
/.dvc/config.local

# --- Data & artifacts ---
# Exported photos: large, and DVC owns their versioning.
data/raw/
# Generated from the manifest by shelf-splits / shelf-label-prep; both are
# reproducible from data/raw + configs, so they are not worth tracking.
# Exception: test_labeling.txt is the FROZEN test set. It was hand-corrected
# on 2026-09-26 (two non-shelf photos swapped out), so no seed regenerates it,
# and every accuracy number is anchored to it. `data/splits/*` (not
# `data/splits/`) is what lets git re-include one file inside the directory.
data/splits/*
!data/splits/test_labeling.txt
# Same for the gold validation set: frozen once written (shelf-splits --gold-val),
# and swapped by hand after its contact sheet, so no seed regenerates it.
!data/splits/gold_val.txt
# Photos rejected at review: tracked so no machine ever draws them again.
!data/splits/gold_val_rejected.txt
# Exception: the Persian labeling config is hand-kept source (translations,
# photo fields, font block), not generator output; it is what runs on the
# server. The `.before-*` copies and the generated English configs stay ignored.
data/label_studio/*
!data/label_studio/labeling_config_scope_fa.xml
# The frozen test-set record (the export itself holds company data, so it stays
# out of git; its sha256 is in this file).
!data/label_studio/FROZEN.md
# One-off scratch list from an early classes.csv probe; the kept version of that
# work lives in investigations/ (see its README).
trial.txt
# Don't blanket-ignore /data here. DVC writes precise
# per-folder .gitignore entries on `dvc add` / `dvc repro`.

# --- Model artifacts and training output ---
# Ultralytics writes runs/<task>/<name>/weights/*.pt; weights are versioned as
# model releases, never as git blobs.
runs/
*.pt
*.onnx

# --- ML noise not worth versioning at all ---
mlruns/
wandb/
*.log

# --- Label Studio database dumps (scripts/deploy_label_studio.sh) ---
# They hold every user, password hash and annotation: store them like the
# photos, never in git.
backups/

# --- IDE / OS ---
.vscode/
.idea/
.DS_Store

# Licensed font (B Yekan, "All Rights Reserved"): kept locally, never committed.
# Embedded into the Label Studio labeling config, not shipped by the deploy script.
deploy/label-studio/fonts/


graphify-out/cache/
# Obsidian per-person workspace state (vault notes themselves are tracked)
docs/vault/.obsidian/
