#!/usr/bin/env python3
"""Require Conventional Commit subjects (stdlib only).

No gitmoji requirement, unlike the sibling merchant repo's hook this is
adapted from: this repo's actual history (see `git log`) is plain
Conventional Commits, so the hook enforces what's already the convention
here instead of retroactively imposing a different one.
"""

import re
import sys
from pathlib import Path

TYPES = (
    "feat", "fix", "refactor", "docs", "test", "ci", "chore", "style", "build",
    "perf", "security", "wip", "deps", "config", "revert",
)
SUBJECT = re.compile(
    rf"(?:{'|'.join(TYPES)})(?:\([a-z0-9][a-z0-9._/-]*\))?!?: \S(?:.*\S)?"
)
HELP = (
    "Invalid commit subject: require a conventional type and a description.\n"
    "Format: <type>[(scope)][!]: <description>\n"
    "Example: feat(export): add HEIC decoding\n"
    "Example: fix(splits)!: change the store hash salt\n"
    "Allowed types: " + ", ".join(TYPES) + "\n"
    "See README.md: Commit messages."
)


def main():
    if len(sys.argv) != 2:
        print("Usage: commit-msg <message-file>", file=sys.stderr)
        return 1
    try:
        lines = Path(sys.argv[1]).read_text(encoding="utf-8").splitlines()
    except (OSError, UnicodeError):
        print("Cannot read UTF-8 commit message file.", file=sys.stderr)
        return 1
    if not lines or SUBJECT.fullmatch(lines[0]) is None:
        print(HELP, file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
