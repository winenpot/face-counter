# Interface to listen on. Use the server's LAN/VPN IP so only the office can reach it.
# 127.0.0.1 = only reachable via SSH tunnel:  ssh -L 7071:localhost:7071 user@server
LS_BIND_IP=127.0.0.1
LS_ADMIN_EMAIL=you@company.com
LS_ADMIN_PASSWORD=CHANGE_ME_long_random
# Absolute path to the project's data/ folder on the host (contains raw/images)
SHELF_DATA_DIR=/srv/shelf-detector/data
